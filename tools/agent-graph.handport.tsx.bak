const AGGC_CARD_ID = 'aggc-card';
const AGGC_NODE_IDS = ['lead', 'research', 'analyst', 'coder', 'writer', 'web', 'notion', 'hubspot', 'db', 'github', 'slack', 'you'];
const AGGC_EDGES: [string, string][] = [
  ['you', 'lead'], ['lead', 'research'], ['lead', 'analyst'], ['lead', 'coder'], ['lead', 'writer'], ['lead', 'slack'],
  ['research', 'web'], ['research', 'notion'], ['analyst', 'db'], ['analyst', 'hubspot'], ['coder', 'github'],
  ['writer', 'notion'], ['writer', 'slack'], ['writer', 'you'],
];
const AGGC_NAME2ID: Record<string, string> = Object.fromEntries(Object.entries(AGGC_NAMES).map(([id, n]) => [n, id]));

const css = ".ui-aggc { --ui-aggc-panel: var(--aui-surface, #ffffff); --ui-aggc-card: #ffffff; --ui-aggc-strong: var(--aui-ink, #000000); --ui-aggc-ink: var(--aui-ink, rgba(0, 0, 0, 0.88)); --ui-aggc-text: var(--aui-muted, rgba(0, 0, 0, 0.61)); --ui-aggc-muted: var(--aui-muted, rgba(0, 0, 0, 0.45)); --ui-aggc-faint: var(--aui-placeholder, rgba(0, 0, 0, 0.27)); --ui-aggc-line: var(--aui-border, rgba(0, 0, 0, 0.06)); --ui-aggc-fill: var(--aui-subtle, rgba(0, 0, 0, 0.06)); --ui-aggc-link: rgba(0, 0, 0, 0.07); --ui-aggc-pulse: rgba(0, 96, 226, 0.8); --ui-aggc-glow: color-mix(in srgb, var(--aui-blue, #0190fe) 16%, transparent); --ui-aggc-breath: rgba(0, 96, 226, 0.12); --ui-aggc-breath-out: rgba(0, 96, 226, 0.02); --ui-aggc-user-bg: rgba(0, 0, 0, 0.88); --ui-aggc-user-fg: #fcfcfc; --ui-aggc-brand-bg: #008ff519; --ui-aggc-brand-fg: #006dcbf2; --ui-aggc-ok: #30a465; --ui-aggc-ok-bg: #00a43319; --ui-aggc-ok-fg: #007d2ee0; --ui-aggc-warn: var(--aui-amber, #e6c24d); --ui-aggc-warn-bg: #ff9c0029; --ui-aggc-warn-fg: var(--aui-warning, #b25e00); --ui-aggc-danger: var(--aui-red, #f04438); --ui-aggc-danger-bg: #f52b0018; --ui-aggc-shine: rgba(255, 255, 255, 0.75); --ui-aggc-danger-fg: #d72400da; --ui-aggc-focus: var(--aui-focus, rgba(0, 96, 226, 0.7)); --ui-aggc-pop: var(--aui-shadow-popover, 0 0 0 0.5px rgba(0, 0, 0, 0.08), 0 12px 28px -10px rgba(0, 0, 0, 0.18), 0 1px 2px rgba(0, 0, 0, 0.05)); --ui-aggc-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.06), 0 1px 1px -1px rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.05); --ui-aggc-lift: 0 0 0 0.5px rgba(0, 0, 0, 0.08), 0 1px 2px 0 rgba(0, 0, 0, 0.06), 0 4px 12px -4px rgba(0, 0, 0, 0.12); --ui-aggc-ease: cubic-bezier(0.32, 0.72, 0.24, 1); position: relative; box-sizing: border-box; width: 100%; min-width: 0px; font-family: var(--aui-font, \"Inter\", \"InterVariable\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif); font-size: 13px; font-weight: 400; line-height: 20px; color: var(--ui-aggc-text); text-align: left; -webkit-font-smoothing: antialiased; }\n.ui-aggc *, .ui-aggc ::before, .ui-aggc ::after { box-sizing: border-box; }\n:where(.ui-aggc) button { margin: 0px; padding: 0px; border: 0px; background: none; font: inherit; color: inherit; text-align: inherit; cursor: pointer; -webkit-tap-highlight-color: transparent; }\n.ui-aggc button:focus-visible { outline: 2px solid var(--ui-aggc-focus); outline-offset: 2px; }\n.ui-aggc p, .ui-aggc ul { margin: 0px; padding: 0px; }\n.ui-aggc svg { display: block; flex: 0 0 auto; overflow: visible; }\n.ui-aggc__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; min-width: 0px; margin-bottom: 16px; }\n.ui-aggc__mark { display: grid; flex: 0 0 auto; place-items: center; width: 16px; color: var(--ui-aggc-pulse); }\n.ui-aggc__title { flex: 0 1 auto; min-width: 0px; overflow: hidden; font-weight: 500; color: var(--ui-aggc-strong); white-space: nowrap; text-overflow: ellipsis; }\n.ui-aggc__sum { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 2px 12px; margin-left: auto; font-size: 12px; line-height: 16px; color: var(--ui-aggc-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }\n.ui-aggc__sum b { font-weight: 500; color: var(--ui-aggc-ink); }\n.ui-aggc__sum-cost { min-width: 40px; font-weight: 500; color: var(--ui-aggc-ink); text-align: right; }\n.ui-aggc[data-narrow] .ui-aggc__bar { row-gap: 6px; }\n.ui-aggc[data-narrow] .ui-aggc__title { line-height: 22px; }\n.ui-aggc[data-narrow] .ui-aggc__sum { flex-basis: 100%; justify-content: space-between; gap: 2px 8px; margin-left: 0px; }\n.ui-aggc__panel { position: relative; overflow: hidden; border-radius: var(--aui-radius-lg, 10px); background: var(--ui-aggc-panel); box-shadow: var(--aui-shadow-card, var(--ui-aggc-shadow)); }\n.ui-aggc__stage { position: relative; width: 100%; min-height: 200px; container-type: inline-size; }\n.ui-aggc__svg { position: absolute; inset: 0px; pointer-events: none; }\n.ui-aggc__halo { animation: 1200ms ease 0s 1 normal both running ui-aggc-fade-in; }\n.ui-aggc__edge { fill: none; stroke: var(--ui-aggc-link); stroke-width: 1.5; stroke-linecap: round; opacity: 1; stroke-dasharray: 1, 1; stroke-dashoffset: 0; animation: ui-aggc-draw 560ms var(--ui-aggc-ease) backwards; transition: opacity 320ms, stroke 300ms; }\n.ui-aggc__edge[data-ask] { stroke: var(--ui-aggc-warn); opacity: 0.9; }\n.ui-aggc__edge[data-error] { stroke: var(--ui-aggc-danger); opacity: 1; transition-duration: 120ms, 120ms; }\n.ui-aggc__edge[data-leaving] { stroke-dashoffset: 0; animation: ui-aggc-retract 420ms var(--ui-aggc-ease) forwards; }\n.ui-aggc[data-focus] .ui-aggc__edge:not([data-near]) { opacity: 0.1; }\n.ui-aggc[data-focus] .ui-aggc__edge[data-near] { opacity: 1; }\n.ui-aggc[data-focus] .ui-aggc__pulse { opacity: 0.25; }\n.ui-aggc__streak { fill: none; stroke-width: 2; stroke-linecap: round; }\n.ui-aggc__streak-glow { fill: none; stroke-width: 4; stroke-linecap: round; opacity: 0.2; }\n.ui-aggc__stop { stop-color: var(--ui-aggc-pulse); }\n.ui-aggc__pulse[data-kind=\"res\"] .ui-aggc__stop { stop-color: var(--ui-aggc-ok); }\n.ui-aggc__pulse:is([data-kind=\"ask\"], [data-kind=\"askres\"]) .ui-aggc__stop { stop-color: var(--ui-aggc-warn); }\n.ui-aggc__pulse[data-kind=\"err\"] .ui-aggc__stop { stop-color: var(--ui-aggc-danger); }\n.ui-aggc__ripple { fill: none; stroke: var(--ui-aggc-pulse); stroke-width: 1; }\n.ui-aggc__ripple:is([data-kind=\"ask\"], [data-kind=\"askres\"]) { stroke: var(--ui-aggc-warn); }\n.ui-aggc__ripple[data-kind=\"err\"] { stroke: var(--ui-aggc-danger); stroke-width: 1.5; }\n.ui-aggc__ripple[data-kind=\"res\"] { stroke: var(--ui-aggc-ok); }\n.ui-aggc__nodes { position: absolute; inset: 0px; pointer-events: none; }\n.ui-aggc__node { position: absolute; top: 0px; left: 0px; width: 0px; height: 0px; transition: opacity 320ms; will-change: transform; }\n.ui-aggc[data-focus] .ui-aggc__node[data-dim] { opacity: 0.3; }\n.ui-aggc__body { position: absolute; top: 0px; left: 0px; transform-origin: 0px 0px; animation: ui-aggc-pop 560ms var(--ui-aggc-ease) both; }\n.ui-aggc__node[data-leaving] .ui-aggc__body { animation: ui-aggc-out 420ms var(--ui-aggc-ease) forwards; }\n.ui-aggc__disc { position: absolute; top: calc(var(--d) / -2); left: calc(var(--d) / -2); display: grid; place-items: center; width: var(--d); height: var(--d); border-radius: 50%; background: var(--ui-aggc-card); box-shadow: inset 0 0 0 999px var(--ui-aggc-state-bg), var(--ui-aggc-shadow); color: var(--ui-aggc-text); pointer-events: auto; transition: width 300ms var(--ui-aggc-ease), height 300ms var(--ui-aggc-ease), top 300ms var(--ui-aggc-ease), left 300ms var(--ui-aggc-ease), box-shadow 240ms ease, transform 240ms var(--ui-aggc-ease); }\n.ui-aggc__disc::before { content: \"\"; position: absolute; inset: -6px; border-radius: 50%; }\n.ui-aggc__disc:hover, .ui-aggc__node[data-open] .ui-aggc__disc { transform: scale(1.06); }\n.ui-aggc__disc > svg { width: 46%; height: 46%; }\n.ui-aggc__initials { font-size: 11px; font-weight: 500; color: var(--ui-aggc-text); }\n.ui-aggc__node[data-kind=\"agent\"] .ui-aggc__disc { box-shadow: inset 0 0 0 999px var(--ui-aggc-state-bg), var(--ui-aggc-lift); }\n.ui-aggc__node[data-kind=\"agent\"] .ui-aggc__disc > svg { width: 44%; height: 44%; }\n.ui-aggc__node[data-kind=\"user\"] .ui-aggc__disc { background: var(--ui-aggc-user-bg); color: var(--ui-aggc-user-fg); box-shadow: rgba(0, 0, 0, 0.16) 0px 1px 2px; }\n.ui-aggc__node[data-kind=\"user\"] .ui-aggc__disc > svg { width: 42%; height: 42%; }\n.ui-aggc__ring { position: absolute; top: calc(var(--d) / -2); left: calc(var(--d) / -2); width: var(--d); height: var(--d); border-radius: 50%; opacity: 0; transition: opacity 400ms; }\n.ui-aggc__node[data-status=\"working\"] .ui-aggc__ring { opacity: 1; animation: 2600ms ease-in-out 0s infinite normal none running ui-aggc-breathe; }\n.ui-aggc__node { --ui-aggc-state: transparent; --ui-aggc-state-bg: transparent; transition: opacity 320ms, --ui-aggc-state 480ms, --ui-aggc-state-bg 480ms; }\n.ui-aggc__node[data-status=\"waiting\"] { --ui-aggc-state: var(--ui-aggc-warn); --ui-aggc-state-bg: var(--ui-aggc-warn-bg); }\n.ui-aggc__node[data-status=\"error\"] { --ui-aggc-state: var(--ui-aggc-danger); --ui-aggc-state-bg: var(--ui-aggc-danger-bg); }\n.ui-aggc__stroke { position: absolute; top: calc(var(--d) / -2); left: calc(var(--d) / -2); width: var(--d); height: var(--d); border-radius: 50%; background: conic-gradient(from 0deg, transparent 0deg, transparent 40deg, var(--ui-aggc-state) 360deg); mask: radial-gradient(farthest-side, transparent calc(100% - 1.25px), rgb(0, 0, 0) calc(100% - 0.75px)); pointer-events: none; animation: 1200ms linear 0s infinite normal none running ui-aggc-spin; transition: width 300ms var(--ui-aggc-ease), height 300ms var(--ui-aggc-ease), top 300ms var(--ui-aggc-ease), left 300ms var(--ui-aggc-ease); }\n.ui-aggc__node:is([data-status=\"waiting\"], [data-status=\"error\"]) .ui-aggc__disc::after { content: \"\"; position: absolute; inset: 0px; border-radius: 50%; background: linear-gradient(110deg, transparent 30%, var(--ui-aggc-shine) 50%, transparent 70%) 130% 0 / 250% 100% no-repeat; pointer-events: none; animation: 2400ms ease-in-out 0s infinite normal none running ui-aggc-shimmer; }\n.ui-aggc__badge { position: absolute; top: calc(var(--d) * -0.36 - 8px); left: calc(var(--d) * 0.36 - 6px); display: grid; place-items: center; width: 14px; height: 14px; border-radius: 50%; box-shadow: 0 0 0 2px var(--ui-aggc-panel); color: rgb(255, 255, 255); pointer-events: none; animation: ui-aggc-pop 360ms var(--ui-aggc-ease) both; }\n.ui-aggc__badge > svg { width: 10px; height: 10px; }\n.ui-aggc__badge[data-status=\"waiting\"] { background: var(--ui-aggc-warn); }\n.ui-aggc__badge[data-status=\"error\"] { background: var(--ui-aggc-danger); }\n.ui-aggc__badge[data-status=\"done\"] { background: color-mix(in srgb, var(--ui-aggc-ok) 18%, var(--ui-aggc-panel)); color: var(--ui-aggc-ok); }\n.ui-aggc__label { position: absolute; top: calc(var(--d) / 2 + 5px); left: 0px; display: grid; justify-items: center; padding: 0px 5px; border-radius: var(--aui-radius-sm, 5px); background: var(--ui-aggc-panel); box-shadow: 0 0 6px 2px var(--ui-aggc-panel); transform: translateX(-50%); white-space: nowrap; pointer-events: none; }\n.ui-aggc__label[data-above] { top: auto; bottom: calc(var(--d) / 2 + 5px); }\n.ui-aggc__node[data-kind=\"agent\"] .ui-aggc__label { top: calc(var(--d) / 2 + 6px); }\n.ui-aggc__node[data-kind=\"agent\"] .ui-aggc__label[data-above] { top: auto; bottom: calc(var(--d) / 2 + 6px); }\n.ui-aggc__name, .ui-aggc__line { width: max-content; max-width: 150px; overflow: hidden; text-overflow: ellipsis; }\n.ui-aggc[data-narrow] :is(.ui-aggc__name, .ui-aggc__line) { max-width: 72px; }\n.ui-aggc__name { font-size: 12px; line-height: 16px; color: var(--ui-aggc-text); }\n.ui-aggc__node[data-kind=\"agent\"] .ui-aggc__name { font-weight: 500; color: var(--ui-aggc-strong); }\n.ui-aggc__line { font-size: 11px; line-height: 14px; color: var(--ui-aggc-muted); }\n.ui-aggc__line[data-status=\"waiting\"] { font-weight: 500; color: var(--ui-aggc-warn-fg); }\n.ui-aggc__line[data-status=\"error\"] { font-weight: 500; color: var(--ui-aggc-danger-fg); }\n.ui-aggc[data-narrow] .ui-aggc__name { font-size: 11px; line-height: 14px; }\n.ui-aggc[data-narrow] .ui-aggc__ring { --ui-aggc-b1: 4px; --ui-aggc-b2: 9px; }\n.ui-aggc[data-narrow] .ui-aggc__label { padding: 0px 4px; }\n.ui-aggc__alerts { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0px; }\n.ui-aggc__chip { display: inline-flex; align-items: center; gap: 4px; height: 22px; margin: -2px 0px; padding: 0px 7px 0px 5px; border-radius: var(--aui-radius-sm, 5px); font-size: 12px; font-weight: 500; white-space: nowrap; animation: ui-aggc-rise 320ms var(--ui-aggc-ease) both; transition: filter 160ms; }\n.ui-aggc__chip > svg { width: 13px; height: 13px; }\n.ui-aggc__chip[data-kind=\"waiting\"] { background: var(--ui-aggc-warn-bg); color: var(--ui-aggc-warn-fg); }\n.ui-aggc__chip[data-kind=\"error\"] { background: var(--ui-aggc-danger-bg); color: var(--ui-aggc-danger-fg); }\n.ui-aggc__chip:hover { filter: saturate(1.3) brightness(0.97); }\n.ui-aggc__card { position: absolute; z-index: 5; display: grid; grid-template-columns: minmax(0px, 1fr); gap: 10px; width: 260px; padding: 10px; border-radius: var(--aui-radius-lg, 10px); background: var(--aui-overlay, var(--ui-aggc-card)); box-shadow: var(--ui-aggc-pop); animation: ui-aggc-rise 220ms var(--ui-aggc-ease) both; }\n.ui-aggc[data-narrow] .ui-aggc__card { right: 8px; bottom: 8px; left: 8px; width: auto; }\n.ui-aggc__card-head { display: flex; align-items: center; gap: 8px; min-width: 0px; }\n.ui-aggc__card-icon { display: grid; flex: 0 0 auto; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--ui-aggc-card); box-shadow: var(--ui-aggc-shadow); font-size: 10px; font-weight: 500; color: var(--ui-aggc-text); }\n.ui-aggc__card-icon > svg { width: 14px; height: 14px; }\n.ui-aggc__card-icon[data-kind=\"user\"] { background: var(--ui-aggc-user-bg); color: var(--ui-aggc-user-fg); box-shadow: none; }\n.ui-aggc__card-who { display: grid; flex: 1 1 0%; min-width: 0px; }\n.ui-aggc__card-name { overflow: hidden; font-weight: 500; line-height: 16px; color: var(--ui-aggc-strong); white-space: nowrap; text-overflow: ellipsis; }\n.ui-aggc__card-detail { overflow: hidden; font-size: 11px; line-height: 14px; color: var(--ui-aggc-muted); white-space: nowrap; text-overflow: ellipsis; }\n.ui-aggc__pill { flex: 0 0 auto; height: 18px; padding: 0px 6px; border-radius: calc(var(--aui-radius-sm, 5px) - 1px); background: var(--ui-aggc-fill); font-size: 11px; font-weight: 500; line-height: 18px; color: var(--ui-aggc-text); white-space: nowrap; }\n.ui-aggc__pill[data-status=\"working\"] { background: var(--ui-aggc-brand-bg); color: var(--ui-aggc-brand-fg); }\n.ui-aggc__pill[data-status=\"waiting\"] { background: var(--ui-aggc-warn-bg); color: var(--ui-aggc-warn-fg); }\n.ui-aggc__pill[data-status=\"error\"] { background: var(--ui-aggc-danger-bg); color: var(--ui-aggc-danger-fg); }\n.ui-aggc__pill[data-status=\"done\"] { background: var(--ui-aggc-ok-bg); color: var(--ui-aggc-ok-fg); }\n.ui-aggc__close { display: grid; flex: 0 0 auto; place-items: center; width: 24px; height: 24px; margin: -3px -3px -3px -2px; border-radius: calc(var(--aui-radius-sm, 5px) + 1px); color: var(--ui-aggc-muted); transition: background-color 160ms, color 160ms; }\n.ui-aggc__close:hover { background: var(--ui-aggc-fill); color: var(--ui-aggc-ink); }\n.ui-aggc__doing { font-size: 12px; line-height: 16px; color: var(--ui-aggc-text); text-align: start; overflow-wrap: anywhere; white-space: pre-line; }\n.ui-aggc__calls { display: grid; border-top: 0.5px solid var(--ui-aggc-line); border-bottom: 0.5px solid var(--ui-aggc-line); list-style: none; }\n.ui-aggc__call { display: flex; align-items: center; gap: 6px; min-width: 0px; height: 28px; font-size: 12px; line-height: 16px; animation: ui-aggc-rise 260ms var(--ui-aggc-ease) both; }\n.ui-aggc__call + .ui-aggc__call { border-top: 0.5px solid var(--ui-aggc-line); }\n.ui-aggc__call-dir { display: grid; flex: 0 0 auto; place-items: center; color: var(--ui-aggc-faint); }\n.ui-aggc__call-icon { display: grid; flex: 0 0 auto; place-items: center; width: 16px; height: 16px; font-size: 7.5px; font-weight: 500; color: var(--ui-aggc-text); }\n.ui-aggc__call-icon > svg { width: 13px; height: 13px; }\n.ui-aggc__call-text { flex: 1 1 0%; min-width: 0px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--ui-aggc-muted); }\n.ui-aggc__call-who { font-weight: 500; color: var(--ui-aggc-ink); }\n.ui-aggc__call-end { flex: 0 0 auto; font-size: 11px; color: var(--ui-aggc-muted); font-variant-numeric: tabular-nums; }\n.ui-aggc__call[data-status=\"pending\"] .ui-aggc__call-end { color: var(--ui-aggc-brand-fg); }\n.ui-aggc__call[data-status=\"error\"] .ui-aggc__call-end { font-weight: 500; color: var(--ui-aggc-danger-fg); }\n.ui-aggc__spin { animation: 900ms linear 0s infinite normal none running ui-aggc-spin; }\n.ui-aggc__card-foot { display: flex; align-items: center; gap: 8px; font-size: 12px; line-height: 16px; color: var(--ui-aggc-muted); font-variant-numeric: tabular-nums; }\n.ui-aggc__card-cost { font-weight: 500; color: var(--ui-aggc-ink); }\n.ui-aggc__legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 14px; padding: 0px 10px 10px; font-size: 11px; line-height: 16px; color: var(--ui-aggc-muted); }\n.ui-aggc__legend > span { display: inline-flex; align-items: center; gap: 6px; }\n.ui-aggc__legend-streak { fill: none; stroke-width: 2; stroke-linecap: round; }\n.ui-aggc__legend-stop { stop-color: var(--ui-aggc-pulse); }\n.ui-aggc__legend-stop[data-kind=\"answer\"] { stop-color: var(--ui-aggc-ok); }\n.ui-aggc__legend-stop[data-kind=\"ask\"] { stop-color: var(--ui-aggc-warn); }\n.ui-aggc__legend-stop[data-kind=\"error\"] { stop-color: var(--ui-aggc-danger); }\n.ui-aggc__sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border: 0px; }\n.ui-aggc .ui-aggc__node { --ui-aggc-r: calc(var(--d) * 0.27); }\n.ui-aggc :is(.ui-aggc__disc, .ui-aggc__ring) { border-radius: var(--ui-aggc-r); }\n.ui-aggc .ui-aggc__disc::before { border-radius: calc(var(--ui-aggc-r) + 6px); }\n.ui-aggc .ui-aggc__badge { top: calc(var(--d) / -2 - 6px); left: calc(var(--d) / 2 - 9px); }\n.ui-aggc .ui-aggc__card-icon { border-radius: 8px; }\n.ui-aggc .ui-aggc__stroke { box-sizing: border-box; padding: 1px; border-radius: var(--ui-aggc-r); background: conic-gradient(from var(--ui-aggc-turn), transparent 0deg, transparent 40deg, var(--ui-aggc-state) 360deg); mask: linear-gradient(rgb(0, 0, 0) 0px, rgb(0, 0, 0) 0px) content-box exclude, linear-gradient(rgb(0, 0, 0) 0px, rgb(0, 0, 0) 0px); animation: 1200ms linear 0s infinite normal none running ui-aggc-turn; }\n@media (prefers-reduced-motion: reduce){.ui-aggc *, .ui-aggc ::before, .ui-aggc ::after { animation: auto ease 0s 1 normal none running none !important; transition: none !important; }}\n@media (prefers-reduced-motion: reduce){.ui-aggc__edge { stroke-dasharray: none; }}\n:where(.dark, [data-theme=\"dark\"]) .ui-aggc { --ui-aggc-panel: var(--aui-surface, #1c1c1f); --ui-aggc-card: #232326; --ui-aggc-strong: var(--aui-ink, #ffffff); --ui-aggc-ink: var(--aui-ink, rgba(255, 255, 255, 0.9)); --ui-aggc-text: var(--aui-muted, rgba(255, 255, 255, 0.62)); --ui-aggc-muted: var(--aui-muted, rgba(255, 255, 255, 0.45)); --ui-aggc-faint: var(--aui-placeholder, rgba(255, 255, 255, 0.28)); --ui-aggc-line: var(--aui-border, rgba(255, 255, 255, 0.08)); --ui-aggc-fill: var(--aui-subtle, rgba(255, 255, 255, 0.08)); --ui-aggc-link: rgba(255, 255, 255, 0.08); --ui-aggc-pulse: var(--aui-blue, #4fb0fe); --ui-aggc-glow: color-mix(in srgb, var(--aui-blue, #4fb0fe) 14%, transparent); --ui-aggc-breath: color-mix(in srgb, var(--aui-blue, #4fb0fe) 16%, transparent); --ui-aggc-breath-out: color-mix(in srgb, var(--aui-blue, #4fb0fe) 3%, transparent); --ui-aggc-user-bg: rgba(255, 255, 255, 0.92); --ui-aggc-user-fg: #141416; --ui-aggc-brand-bg: #0077ff3a; --ui-aggc-brand-fg: #70b8ff; --ui-aggc-ok: var(--aui-green, #5fc88a); --ui-aggc-ok-bg: #00f04a1f; --ui-aggc-ok-fg: var(--aui-green, #5fc88a); --ui-aggc-warn: var(--aui-warning, #ffb35c); --ui-aggc-warn-bg: #fb6a0025; --ui-aggc-warn-fg: var(--aui-warning, #ffb35c); --ui-aggc-danger: var(--aui-red, #ff6b5f); --ui-aggc-danger-bg: #ff35232b; --ui-aggc-shine: rgba(255, 255, 255, 0.16); --ui-aggc-danger-fg: var(--aui-danger, #ff8a7a); --ui-aggc-focus: var(--aui-focus, rgba(77, 141, 255, 0.8)); --ui-aggc-pop: var(--aui-shadow-popover, 0 0 0 0.5px rgba(255, 255, 255, 0.12), 0 12px 28px -10px rgba(0, 0, 0, 0.6)); --ui-aggc-shadow: 0 0 0 0.5px rgba(255, 255, 255, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.4); --ui-aggc-lift: 0 0 0 0.5px rgba(255, 255, 255, 0.14), 0 1px 2px 0 rgba(0, 0, 0, 0.4), 0 4px 12px -4px rgba(0, 0, 0, 0.5); }\n.lp-show__main > .ui-agtc .ui-agtc__node { padding-bottom: 72px; }\n.lp-show .ui-agtc { --ui-agtc-card-w: 320px; }\n.lp-show .ui-agtc__node > * { max-width: 236px; }\n.lp-show__main > .ui-agtc .ui-agtc__node { row-gap: 14px; }\n.lp-show .ui-agtc__status { align-self: center; }\n.lp-show .ui-agtc__bar { display: none; }\n.lp-show .ui-agtc__node, .lp-show__main > .ui-ccc .ui-ccc__body { box-shadow: var(--ui-agtc-shadow,var(--ui-ccc-shadow)), 0 18px 40px -10px #0000001f, 0 40px 80px -24px #0000001a; }\n.lp-show__above .ui-agtc__node { box-shadow: var(--ui-agtc-shadow), 0 2px 4px -2px #0000000a; }\n.agg-demo { grid-template-columns: minmax(0px, 780px); justify-content: center; width: 100%; display: grid; }\n.card__preview .agg-demo { grid-template-columns: auto; align-content: start; padding: 44px 16px 0px; position: absolute; inset: 0px; }\n.card__preview .agg-demo :is(.ui-agg, .ui-aggc) { zoom: 0.4; width: 640px; }\n.stage:has(.agg-demo) { height: 680px; }\n.stage .agg-demo { box-sizing: border-box; align-self: start; margin-top: 48px; padding-inline: 24px; }\n@media (max-width: 760px){.stage:has(.agg-demo) { height: auto; padding-bottom: 12px; padding-left: 12px; padding-right: 12px; }}\n@media (max-width: 760px){.stage .agg-demo { margin-top: 84px; padding-inline: 0px; }}\n@keyframes ui-aggc-turn {100%{--ui-aggc-turn: 360deg;}}\n@keyframes ui-aggc-draw {0%{stroke-dashoffset: 1;}}\n@keyframes ui-aggc-retract {0%{stroke-dashoffset: 0;}100%{stroke-dashoffset: 1; opacity: 0;}}\n@keyframes ui-aggc-pop {0%{opacity: 0; transform: scale(0.4);}}\n@keyframes ui-aggc-out {100%{opacity: 0; transform: scale(0.5);}}\n@keyframes ui-aggc-rise {0%{opacity: 0; transform: translateY(4px) scale(0.98);}}\n@keyframes ui-aggc-fade-in {0%{opacity: 0;}}\n@keyframes ui-aggc-breathe {0%, 100%{box-shadow: 0 0 0 var(--ui-aggc-b1, 5px) var(--ui-aggc-breath);}50%{box-shadow: 0 0 0 var(--ui-aggc-b2, 11px) var(--ui-aggc-breath-out);}}\n@keyframes ui-aggc-shimmer {0%{background-position: 130% 0px;}55%, 100%{background-position: -30% 0px;}}\n@keyframes ui-aggc-spin {100%{transform: rotate(360deg);}}";

export default function AgentGraphDemo() {
  const rootRef = useRef<HTMLDivElement>(null);
  const stageRef = useRef<HTMLDivElement>(null);
  const cardRef = useRef<HTMLDivElement>(null);
  const [hov, setHov] = useState<string | null>(null);
  const [open, setOpen] = useState<string | null>(null);
  const [narrow, setNarrow] = useState(false);
  const focusId = hov ?? (open ? open : null);

  const discId = (target: EventTarget | null): string | null => {
    const disc = (target as Element | null)?.closest?.('.ui-aggc__disc');
    if (!disc) return null;
    const node = disc.closest('.ui-aggc__node');
    const root = rootRef.current;
    if (!node || !root) return null;
    const idx = Array.prototype.indexOf.call(root.querySelectorAll('.ui-aggc__node'), node);
    const name = (disc.getAttribute('aria-label') || '').split(',')[0];
    return AGGC_NAME2ID[name] ?? (idx >= 0 ? AGGC_NODE_IDS[idx] : null);
  };

  const onPointerOver = (e: PointerEvent<HTMLDivElement>) => {
    if (e.pointerType !== 'mouse') return;
    const id = discId(e.target);
    if (id) setHov(id);
  };
  const onPointerOut = (e: PointerEvent<HTMLDivElement>) => {
    const disc = (e.target as Element | null)?.closest?.('.ui-aggc__disc');
    if (!disc) return;
    const rel = e.relatedTarget as Element | null;
    if (rel && rel.closest?.('.ui-aggc__disc') === disc) return;
    const id = discId(disc);
    if (id) setHov((p) => (p === id ? null : p));
  };
  const onFocus = (e: FocusEvent<HTMLDivElement>) => {
    const id = discId(e.target);
    if (id) setHov(id);
  };
  const onBlur = (e: FocusEvent<HTMLDivElement>) => {
    const id = discId(e.target);
    if (id) setHov((p) => (p === id ? null : p));
  };
  const onClick = (e: MouseEvent<HTMLDivElement>) => {
    const t = e.target as Element | null;
    const disc = t?.closest?.('[data-agg-node]');
    if (disc) {
      const id = discId(disc);
      if (id) setOpen((p) => (p === id ? null : id));
      return;
    }
    if (t?.closest?.('.ui-aggc__close')) setOpen(null);
  };
  const onCardKeyDown = (e: KeyboardEvent<HTMLDivElement>) => {
    if (e.key !== 'Escape' || !open) return;
    setOpen(null);
    const idx = AGGC_NODE_IDS.indexOf(open);
    const btn = idx >= 0 ? rootRef.current?.querySelectorAll('.ui-aggc__node')[idx]?.querySelector('button') : null;
    (btn as HTMLElement | null | undefined)?.focus?.();
  };

  useLayoutEffect(() => {
    const root = rootRef.current;
    if (!root) return;
    if (focusId) root.setAttribute('data-focus', ''); else root.removeAttribute('data-focus');
    const q = new Set<string>();
    if (focusId) {
      q.add(focusId);
      for (const [a, b] of AGGC_EDGES) {
        if (a === focusId) q.add(b);
        if (b === focusId) q.add(a);
      }
    }
    root.querySelectorAll('.ui-aggc__node').forEach((n, i) => {
      const id = AGGC_NODE_IDS[i];
      if (!id) return;
      if (focusId && !q.has(id)) n.setAttribute('data-dim', ''); else n.removeAttribute('data-dim');
      if (open === id) n.setAttribute('data-open', ''); else n.removeAttribute('data-open');
      const disc = n.querySelector('.ui-aggc__disc');
      if (disc) {
        if (open === id) {
          disc.setAttribute('aria-expanded', 'true');
          disc.setAttribute('aria-controls', AGGC_CARD_ID);
        } else {
          disc.setAttribute('aria-expanded', 'false');
          disc.removeAttribute('aria-controls');
        }
      }
    });
    const paths = root.querySelectorAll('.ui-aggc__edge');
    if (paths.length === AGGC_EDGES.length) {
      paths.forEach((p, i) => {
        const [a, b] = AGGC_EDGES[i];
        const near = !!focusId && q.has(a) && q.has(b) && (a === focusId || b === focusId);
        if (near) p.setAttribute('data-near', ''); else p.removeAttribute('data-near');
      });
    }
  }, [focusId, open]);

  useLayoutEffect(() => {
    const card = cardRef.current;
    if (!card) return;
    if (!open || narrow) {
      card.style.left = '';
      card.style.top = '';
      return;
    }
    const root = rootRef.current;
    const stage = stageRef.current;
    if (!root || !stage) return;
    const idx = AGGC_NODE_IDS.indexOf(open);
    const nodeEl = idx >= 0 ? (root.querySelectorAll('.ui-aggc__node')[idx] as HTMLElement | undefined) : undefined;
    const tf = nodeEl?.style.transform || '';
    const m = /translate3d\(\s*([-\d.]+)px\s*,\s*([-\d.]+)px/.exec(tf) || /translate\(\s*([-\d.]+)px\s*,\s*([-\d.]+)px/.exec(tf);
    if (!nodeEl || !m) return;
    const spotX = parseFloat(m[1]);
    const spotY = parseFloat(m[2]);
    const w = stage.clientWidth;
    const h = stage.clientHeight;
    const cw = card.offsetWidth;
    const ch = card.offsetHeight;
    const rad = (parseFloat(nodeEl.style.getPropertyValue('--d') || '40') || 40) / 2;
    const cardRight = spotX < w / 2;
    const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi);
    card.style.left = `${clamp(cardRight ? spotX + rad + 18 : spotX - rad - 18 - cw, 8, w - cw - 8)}px`;
    card.style.top = `${clamp(spotY - ch / 2, 8, h - ch - 8)}px`;
  }, [open, narrow]);

  useLayoutEffect(() => {
    if (!open) return;
    cardRef.current?.querySelector<HTMLElement>('.ui-aggc__close')?.focus();
  }, [open]);

  useEffect(() => {
    if (!open) return;
    const onDown = (e: globalThis.PointerEvent) => {
      const t = e.target as Element | null;
      if (cardRef.current?.contains(t)) return;
      if (t?.closest?.('[data-agg-node]')) return;
      setOpen(null);
    };
    document.addEventListener('pointerdown', onDown);
    return () => document.removeEventListener('pointerdown', onDown);
  }, [open]);

  useEffect(() => {
    const stage = stageRef.current;
    if (!stage) return;
    const update = () => setNarrow(stage.clientWidth < 520);
    update();
    const ro = new ResizeObserver(update);
    ro.observe(stage);
    return () => ro.disconnect();
  }, []);

  const aggcCard = open && AGGC_CARDS[open] ? (
    <div
      ref={cardRef}
      id={AGGC_CARD_ID}
      className="ui-aggc__card"
      role="dialog"
      aria-label={AGGC_NAMES[open]}
      onKeyDown={onCardKeyDown}
      dangerouslySetInnerHTML={{ __html: AGGC_CARDS[open] }}
    />
  ) : null;

  return (
    <>
      <style>{css}</style>
      <div className="agg-demo"><div className="ui-aggc" ref={rootRef} data-narrow={narrow ? '' : undefined} onPointerOver={onPointerOver} onPointerOut={onPointerOut} onFocus={onFocus} onBlur={onBlur} onClick={onClick}><header className="ui-aggc__bar"><span className="ui-aggc__mark"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 8.4 3.2 4M8 8.4l5-4.2M8 8.4l4.4 4" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round" opacity="0.5"></path><circle cx="8" cy="8.4" r="2.4" fill="currentColor"></circle><circle cx="3.2" cy="4" r="1.6" fill="currentColor"></circle><circle cx="13" cy="4.2" r="1.6" fill="currentColor"></circle><circle cx="12.4" cy="12.4" r="1.6" fill="currentColor"></circle></svg></span><span className="ui-aggc__title" title="Agent graph">Agent graph</span><span className="ui-aggc__sum"><span><b>5</b> agents</span><span><b>6</b> tools</span><span><b>2</b> calls/min</span><span className="ui-aggc__sum-cost">$0.02</span></span></header><div className="ui-aggc__panel"><div className="ui-aggc__stage" ref={stageRef} role="group" aria-label="Agent graph: 5 agents and 6 tools" style={{height: '486px'}}><svg className="ui-aggc__svg" width="756" height="486" aria-hidden="true"><defs><radialGradient id="_r_1_-glow"><stop offset="0" style={{stopColor: 'var(--ui-aggc-glow)'}}></stop><stop offset="1" style={{stopColor: 'var(--ui-aggc-glow)', stopOpacity: 0}}></stop></radialGradient><filter id="_r_1_-blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="1.5"></feGaussianBlur></filter></defs><ellipse className="ui-aggc__halo" cx="378" cy="243" rx="140.85" ry="81" fill="url(#_r_1_-glow)"></ellipse><g><path className="ui-aggc__edge" pathLength="1" d="M378 243L378 99Q378 91 370 91L210.3 91" style={{animationDelay: '1040ms'}}></path><path className="ui-aggc__edge" pathLength="1" d="M386 243L386 179.9Q386 171.9 394 171.9L474 171.9" style={{animationDelay: '140ms'}}></path><path className="ui-aggc__edg